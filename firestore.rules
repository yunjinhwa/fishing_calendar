rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function recentlyAuthenticated() {
      return signedIn()
        && request.auth.token.auth_time is int
        && request.time.toMillis() / 1000
          - request.auth.token.auth_time < 300;
    }

    function validNicknameData(data, uid, nicknameKey) {
      return data.keys().hasOnly(['uid', 'nickname', 'nicknameKey'])
        && data.uid == uid
        && data.nickname is string
        && data.nicknameKey is string
        && data.nickname == data.nickname.trim()
        && data.nickname.size() >= 2
        && data.nickname.size() <= 20
        && data.nickname.matches('^[A-Za-z0-9가-힣 _-]+$')
        && data.nicknameKey == data.nickname.lower()
        && data.nicknameKey == nicknameKey;
    }

    function profileMatchesClaim(uid, nicknameKey, nickname) {
      let profilePath =
        /databases/$(database)/documents/user_profiles/$(uid);
      let profile = getAfter(profilePath).data;
      return existsAfter(profilePath)
        && validNicknameData(profile, uid, nicknameKey)
        && profile.nickname == nickname;
    }

    function claimMatchesProfile(uid, nicknameKey, nickname) {
      let claimPath =
        /databases/$(database)/documents/nickname_claims/$(nicknameKey);
      let claim = getAfter(claimPath).data;
      return existsAfter(claimPath)
        && validNicknameData(claim, uid, nicknameKey)
        && claim.nickname == nickname;
    }

    function nicknameReleasedByRename(uid, nicknameKey) {
      let profilePath =
        /databases/$(database)/documents/user_profiles/$(uid);
      let currentProfile = get(profilePath).data;
      let nextProfile = getAfter(profilePath).data;
      return !accountDeletionRequested(uid)
        && exists(profilePath)
        && currentProfile.uid == uid
        && currentProfile.nicknameKey == nicknameKey
        && existsAfter(profilePath)
        && nextProfile.nicknameKey != nicknameKey
        && validNicknameData(nextProfile, uid, nextProfile.nicknameKey)
        && claimMatchesProfile(
          uid, nextProfile.nicknameKey, nextProfile.nickname
        );
    }

    function ownsUserData(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function accountDeletionRequested(uid) {
      return ownsUserData(uid)
        && exists(
          /databases/$(database)/documents/account_deletion_requests/$(uid)
        );
    }

    function launchRecordAccessEnabled() {
      let settingsPath =
        /databases/$(database)/documents/app_settings/record_access;
      return exists(settingsPath)
        && get(settingsPath).data.get('allMembersSyncEnabled', false) == true;
    }

    function hasActivePaidEntitlement(uid) {
      let entitlementPath =
        /databases/$(database)/documents/plan_entitlements/$(uid);
      let entitlement = get(entitlementPath).data;
      return exists(entitlementPath)
        && entitlement.planType == 'PAID'
        && entitlement.status == 'ACTIVE'
        && (
          !entitlement.keys().hasAny(['expiresAt'])
          || entitlement.expiresAt == null
          || (
            entitlement.expiresAt is timestamp
            && entitlement.expiresAt > request.time
          )
        );
    }

    function hasRecordSyncAccess(uid) {
      return ownsUserData(uid)
        && !accountDeletionRequested(uid)
        && (launchRecordAccessEnabled() || hasActivePaidEntitlement(uid));
    }

    function validSyncReceiptV1Shape(data, uid, outboxId) {
      return data.keys().hasOnly([
          'ownerUid', 'outboxId', 'recordId', 'operationType',
          'resultingVersionNo', 'processedAt'
        ])
        && data.ownerUid == uid
        && data.outboxId == outboxId
        && data.recordId is string
        && data.recordId.matches('^[^/]{1,200}$')
        && data.outboxId is string
        && data.outboxId.matches('^[^/]{1,300}$')
        && data.operationType in ['create', 'update', 'delete']
        && data.resultingVersionNo is int
        && data.resultingVersionNo >= 1
        && data.processedAt == request.time;
    }

    function validSyncReceiptV2Shape(data, uid, outboxId) {
      return data.keys().hasOnly([
          'schemaVersion', 'ownerUid', 'outboxId', 'recordId',
          'operationType', 'baseVersionNo', 'resultingVersionNo',
          'mutationFingerprint', 'processedAt'
        ])
        && data.schemaVersion == 2
        && data.ownerUid == uid
        && data.outboxId == outboxId
        && data.recordId is string
        && data.recordId.matches('^[^/]{1,200}$')
        && data.outboxId is string
        && data.outboxId.matches('^[^/]{1,300}$')
        && data.operationType in ['create', 'update', 'delete']
        && data.baseVersionNo is int
        && data.baseVersionNo >= 0
        && data.resultingVersionNo is int
        && data.resultingVersionNo == data.baseVersionNo + 1
        && data.mutationFingerprint is string
        && data.mutationFingerprint.matches('^[0-9a-f]{64}$')
        && data.processedAt == request.time;
    }

    function validSyncReceiptShape(data, uid, outboxId) {
      return validSyncReceiptV1Shape(data, uid, outboxId)
        || validSyncReceiptV2Shape(data, uid, outboxId);
    }

    function receiptMatchesBase(data, uid, outboxId, baseVersionNo) {
      return (
          validSyncReceiptV1Shape(data, uid, outboxId)
          && data.resultingVersionNo == baseVersionNo + 1
        )
        || (
          validSyncReceiptV2Shape(data, uid, outboxId)
          && data.baseVersionNo == baseVersionNo
        );
    }

    function recordHasMatchingReceipt(
      data,
      uid,
      recordId,
      operationType,
      baseVersionNo
    ) {
      let receipt = getAfter(
        /databases/$(database)/documents/users/$(uid)/sync_receipts/$(data.lastOutboxId)
      ).data;
      return existsAfter(
          /databases/$(database)/documents/users/$(uid)/sync_receipts/$(data.lastOutboxId))
        && validSyncReceiptShape(receipt, uid, data.lastOutboxId)
        && receipt.recordId == recordId
        && receipt.operationType == operationType
        && receiptMatchesBase(
          receipt,
          uid,
          data.lastOutboxId,
          baseVersionNo
        )
        && receipt.resultingVersionNo == data.versionNo;
    }

    function receiptHasMatchingRecord(data, uid, outboxId) {
      let recordPath =
        /databases/$(database)/documents/users/$(uid)/records/$(data.recordId);
      let nextRecord = getAfter(recordPath).data;
      return existsAfter(recordPath)
        && nextRecord.ownerUid == uid
        && nextRecord.recordId == data.recordId
        && nextRecord.lastOutboxId == outboxId
        && nextRecord.versionNo == data.resultingVersionNo
        && nextRecord.serverUpdatedAt == request.time
        && (
          (data.operationType == 'create'
            && !exists(recordPath)
            && receiptMatchesBase(data, uid, outboxId, 0)
            && nextRecord.recordStatus == 'ACTIVE')
          || (data.operationType == 'update'
            && exists(recordPath)
            && get(recordPath).data.ownerUid == uid
            && get(recordPath).data.recordId == data.recordId
            && receiptMatchesBase(
              data,
              uid,
              outboxId,
              get(recordPath).data.versionNo
            )
            && nextRecord.recordStatus == 'ACTIVE')
          || (data.operationType == 'delete'
            && exists(recordPath)
            && get(recordPath).data.ownerUid == uid
            && get(recordPath).data.recordId == data.recordId
            && receiptMatchesBase(
              data,
              uid,
              outboxId,
              get(recordPath).data.versionNo
            )
            && nextRecord.recordStatus == 'DELETED')
        );
    }

    function validRecordBase(data, uid, recordId) {
      return data.schemaVersion in [1, 2, 3]
        && data.ownerUid == uid
        && data.recordId == recordId
        && data.recordId.matches('^[^/]{1,200}$')
        && data.recordStatus in ['ACTIVE', 'DELETED']
        && data.versionNo is int
        && data.versionNo >= 1
        && data.clientModifiedAt is timestamp
        && data.createdAt is timestamp
        && data.serverUpdatedAt == request.time
        && data.lastOutboxId is string
        && data.lastOutboxId.matches('^[^/]{1,300}$');
    }

    // BEGIN GENERATED CATCHES GRAMMAR
    // Generated by dart run tool/generate_catches_rules.dart. Do not edit.
    // Separate bounds avoid RE2's nested repetition expansion limit.
    function validCatchesJson(value) {
      return value is string
        && value.size() <= 100000
        && value.matches('\\[(?:\\{"speciesName":"(?:\\\\u[0-9a-f]{4})+","lengthCm":(?:null|(?:-?0\\.0{16}e\\+0|[1-9]\\.[0-9]{16}e(?:\\+(?:[0-9]|[1-9][0-9]|[12][0-9]{2}|30[0-7])|-(?:[1-9]|[1-9][0-9]|[12][0-9]{2}|3[01][0-9]|32[0-4]))|(?:1\\.[0-6][0-9]{15}|1\\.7[0-8][0-9]{14}|1\\.79[0-6][0-9]{13}|1\\.797[0-5][0-9]{12}|1\\.7976[0-8][0-9]{11}|1\\.79769[0-2][0-9]{10}|1\\.7976930[0-9]{9}|1\\.7976931[0-2][0-9]{8}|1\\.79769313[0-3][0-9]{7}|1\\.797693134[0-7][0-9]{6}|1\\.7976931348[0-5][0-9]{5}|1\\.79769313486[0-1][0-9]{4}|1\\.797693134862[0-2][0-9]{3}|1\\.79769313486230[0-9]{2}|1\\.79769313486231[0-4][0-9]{1}|1\\.797693134862315[0-6]|1\\.7976931348623157)e\\+308)),"weightG":(?:null|(?:0|[1-9][0-9]{0,17}|(?:[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)))\\}(?:,\\{"speciesName":"(?:\\\\u[0-9a-f]{4})+","lengthCm":(?:null|(?:-?0\\.0{16}e\\+0|[1-9]\\.[0-9]{16}e(?:\\+(?:[0-9]|[1-9][0-9]|[12][0-9]{2}|30[0-7])|-(?:[1-9]|[1-9][0-9]|[12][0-9]{2}|3[01][0-9]|32[0-4]))|(?:1\\.[0-6][0-9]{15}|1\\.7[0-8][0-9]{14}|1\\.79[0-6][0-9]{13}|1\\.797[0-5][0-9]{12}|1\\.7976[0-8][0-9]{11}|1\\.79769[0-2][0-9]{10}|1\\.7976930[0-9]{9}|1\\.7976931[0-2][0-9]{8}|1\\.79769313[0-3][0-9]{7}|1\\.797693134[0-7][0-9]{6}|1\\.7976931348[0-5][0-9]{5}|1\\.79769313486[0-1][0-9]{4}|1\\.797693134862[0-2][0-9]{3}|1\\.79769313486230[0-9]{2}|1\\.79769313486231[0-4][0-9]{1}|1\\.797693134862315[0-6]|1\\.7976931348623157)e\\+308)),"weightG":(?:null|(?:0|[1-9][0-9]{0,17}|(?:[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)))\\})*)?\\]')
        && !value.matches('.*"speciesName":"(?:\\\\u(?:000[9a-d]|0020|0085|00a0|1680|200[0-a]|202[89f]|205f|3000|feff))+".*')
        && !value.matches('.*"speciesName":"(?:\\\\u[0-9a-f]{4}){101,}".*')
        && value.split('"speciesName":').size() <= 101;
    }
    // END GENERATED CATCHES GRAMMAR

    function finiteNumber(value) {
      let maximum = float('1.7976931348623157e308');
      return value is number
        && value >= -maximum && value <= maximum;
    }

    function validActiveRecord(data, uid, recordId) {
      return data.keys().hasOnly([
          'schemaVersion', 'ownerUid', 'recordId', 'recordStatus',
          'location', 'locationAlias', 'startAt', 'endAt', 'genreName', 'tide', 'weather',
          'airTemperature', 'waterTemperature', 'catchesJson', 'memo',
          'photoUploadPending', 'versionNo', 'clientModifiedAt',
          'createdAt', 'serverUpdatedAt', 'lastOutboxId',
          'latitude', 'longitude'
        ])
        && validRecordBase(data, uid, recordId)
        // v1/v2 remain readable by the app, but their unvalidated catch arrays
        // may no longer be written through a client, including old clients.
        && data.schemaVersion == 3
        && (
          !data.keys().hasAny(['latitude', 'longitude'])
          || (data.keys().hasAll(['latitude', 'longitude'])
            && data.latitude is number
            && data.latitude >= -90 && data.latitude <= 90
            && data.longitude is number
            && data.longitude >= -180 && data.longitude <= 180)
        )
        && data.recordStatus == 'ACTIVE'
        && data.location is string
        && data.location.size() > 0
        && data.location.trim().size() > 0
        && data.location.size() <= 200
        && (!data.keys().hasAny(['locationAlias'])
          || (data.locationAlias is string
            && data.locationAlias.trim().size() > 0
            && data.locationAlias.size() <= 100))
        && data.startAt is timestamp
        && data.endAt is timestamp
        && data.startAt < data.endAt
        && data.genreName is string
        && data.genreName.size() > 0
        && data.genreName.trim().size() > 0
        && data.genreName.size() <= 100
        && (data.tide == null
          || (data.tide is string && data.tide.size() <= 100))
        && (data.weather == null
          || (data.weather is string && data.weather.size() <= 100))
        && (data.airTemperature == null || finiteNumber(data.airTemperature))
        && (data.waterTemperature == null || finiteNumber(data.waterTemperature))
        && validCatchesJson(data.catchesJson)
        && (data.memo == null || (data.memo is string && data.memo.size() <= 5000))
        && data.photoUploadPending is bool;
    }

    function validDeletedRecord(data, uid, recordId) {
      return data.keys().hasOnly([
          'schemaVersion', 'ownerUid', 'recordId', 'recordStatus',
          'versionNo', 'clientModifiedAt', 'createdAt', 'serverUpdatedAt',
          'lastOutboxId'
        ])
        && validRecordBase(data, uid, recordId)
        && data.schemaVersion == 1
        && data.recordStatus == 'DELETED';
    }

    function validRecord(data, uid, recordId) {
      return validActiveRecord(data, uid, recordId)
        || validDeletedRecord(data, uid, recordId);
    }

    function validSyncReceipt(data, uid, outboxId) {
      return validSyncReceiptShape(data, uid, outboxId)
        && receiptHasMatchingRecord(data, uid, outboxId);
    }

    match /nickname_claims/{nicknameKey} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && !accountDeletionRequested(request.auth.uid)
        && request.auth.uid == request.resource.data.uid
        && validNicknameData(
          request.resource.data,
          request.auth.uid,
          nicknameKey
        )
        && profileMatchesClaim(
          request.auth.uid, nicknameKey, request.resource.data.nickname
        );

      allow update: if signedIn()
        && !accountDeletionRequested(request.auth.uid)
        && resource.data.uid == request.auth.uid
        && resource.data.nicknameKey == nicknameKey
        && request.resource.data.uid == request.auth.uid
        && validNicknameData(
          request.resource.data,
          request.auth.uid,
          nicknameKey
        )
        && profileMatchesClaim(
          request.auth.uid, nicknameKey, request.resource.data.nickname
        );

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && (
          !existsAfter(
            /databases/$(database)/documents/user_profiles/$(request.auth.uid)
          )
          || nicknameReleasedByRename(request.auth.uid, nicknameKey)
        );
    }

    match /user_profiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      allow create: if signedIn()
        && !accountDeletionRequested(uid)
        && request.auth.uid == uid
        && validNicknameData(request.resource.data, uid, request.resource.data.nicknameKey)
        && claimMatchesProfile(
          uid, request.resource.data.nicknameKey, request.resource.data.nickname
        );

      allow update: if signedIn()
        && !accountDeletionRequested(uid)
        && request.auth.uid == uid
        && resource.data.uid == uid
        && validNicknameData(resource.data, uid, resource.data.nicknameKey)
        && validNicknameData(request.resource.data, uid, request.resource.data.nicknameKey)
        && claimMatchesProfile(
          uid, request.resource.data.nicknameKey, request.resource.data.nickname
        )
        && (
          resource.data.nicknameKey == request.resource.data.nicknameKey
          || !existsAfter(
            /databases/$(database)/documents/nickname_claims/$(resource.data.nicknameKey)
          )
        );

      allow delete: if signedIn()
        && request.auth.uid == uid
        && resource.data.uid == uid
        && !existsAfter(
          /databases/$(database)/documents/nickname_claims/$(resource.data.nicknameKey)
        );
    }

    // Only administrators can change the shared launch access setting.
    match /app_settings/record_access {
      allow get: if signedIn();
    }

    // Plan entitlements are written only by a trusted administrator or billing
    // backend. A member can only remove their own entitlement after entering
    // the irreversible account-deletion flow.
    match /plan_entitlements/{uid} {
      allow get: if ownsUserData(uid);
      allow delete: if accountDeletionRequested(uid);
      allow list, create, update: if false;
    }

    // This tombstone contains no profile data. It is intentionally immutable
    // and remains after Firebase Auth deletion so an interrupted cleanup cannot
    // restore cloud access on another signed-in device.
    match /account_deletion_requests/{uid} {
      allow get: if ownsUserData(uid);
      allow list: if false;
      allow create: if ownsUserData(uid)
        && recentlyAuthenticated()
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'uid', 'status', 'requestedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.uid == uid
        && request.resource.data.status == 'REQUESTED'
        && request.resource.data.requestedAt == request.time;
      allow update, delete: if false;
    }

    match /users/{uid}/records/{recordId} {
      allow get, list: if hasRecordSyncAccess(uid)
        || accountDeletionRequested(uid);

      allow create: if hasRecordSyncAccess(uid)
        && validActiveRecord(request.resource.data, uid, recordId)
        && request.resource.data.versionNo == 1
        && request.resource.data.createdAt == request.time
        && recordHasMatchingReceipt(
          request.resource.data,
          uid,
          recordId,
          'create',
          0
        );

      allow update: if hasRecordSyncAccess(uid)
        && resource.data.ownerUid == uid
        && resource.data.recordId == recordId
        && validRecord(request.resource.data, uid, recordId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.versionNo == resource.data.versionNo + 1
        && (
          (request.resource.data.recordStatus == 'ACTIVE'
            && recordHasMatchingReceipt(
              request.resource.data,
              uid,
              recordId,
              'update',
              resource.data.versionNo
            ))
          || (request.resource.data.recordStatus == 'DELETED'
            && recordHasMatchingReceipt(
              request.resource.data,
              uid,
              recordId,
              'delete',
              resource.data.versionNo
            ))
        );

      // Normal deletes remain validated tombstones. Physical deletion is only
      // available after this account has entered the deletion flow.
      allow delete: if accountDeletionRequested(uid);
    }

    match /users/{uid}/sync_receipts/{outboxId} {
      allow get: if hasRecordSyncAccess(uid)
        || accountDeletionRequested(uid);
      allow list: if accountDeletionRequested(uid);
      allow create: if hasRecordSyncAccess(uid)
        && validSyncReceipt(request.resource.data, uid, outboxId);
      allow delete: if accountDeletionRequested(uid);
      allow update: if false;
    }
  }
}
